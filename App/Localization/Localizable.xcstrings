    "sync.error.accountChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud account or container changed. Sync is blocked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云账户或容器已变化，同步已阻止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端帳號或容器已變更，同步已阻止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドのアカウントまたはコンテナが変更されました。同期を停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 계정 또는 컨테이너가 변경되었습니다. 동기화가 차단되었습니다."
          }
        }
      }
    },
    "sync.error.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync history reached the review limit. Local clips are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步历史已达到验收容量上限，本地收藏不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步歷史已達驗收容量上限，本機收藏不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期履歴が検証用の上限に達しました。端末内のクリップは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 기록이 검증용 한도에 도달했습니다. 로컬 클립은 변경되지 않았습니다."
          }
        }
      }
    },
    "sync.error.accountUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud account unavailable. Check system account settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 账户不可用，请检查系统账户设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 帳號無法使用，請檢查系統帳號設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud アカウントを利用できません。システムのアカウント設定を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 계정을 사용할 수 없습니다. 시스템 계정 설정을 확인하세요."
          }
        }
      }
    },
    "sync.error.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync could not complete. Your local clips are retained. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步未完成，本地收藏已保留，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步未完成，本機收藏已保留，請稍後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期が完了しませんでした。端末内のクリップは保持されています。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화를 완료하지 못했습니다. 로컬 클립은 유지됩니다. 나중에 다시 시도하세요."
          }
        }
      }
    },
    "sync.consent.title": {
      "extractionState": "manual",
      "localizations": {
