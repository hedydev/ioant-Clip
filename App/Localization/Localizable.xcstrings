    "settings.language.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply to the app interface. Saved content and tags are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只改变应用界面语言，不修改收藏内容和标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只變更應用程式介面語言，不修改收藏內容與標籤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの表示言語のみ変更します。保存した内容とタグは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 인터페이스 언어만 변경되며 저장된 콘텐츠와 태그는 그대로 유지됩니다."
          }
        }
      }
    },
