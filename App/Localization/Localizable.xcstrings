    "sync.consent.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link account and sync"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定账户并同步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "綁定帳號並同步"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連携して同期"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 연결 및 동기화"
          }
        }
      }
    },
    "sync.consent.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current clips and tag colors will be uploaded to your private iCloud container and merged with its data. Local version history before this enrollment will be replaced; previously deleted clips will not be uploaded. Later revisions, including deleted content, may remain in sync history. Account switching is not supported in this review build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前收藏及标签颜色将上传到你的私有 iCloud 容器并与云端数据合并。绑定前的本地版本历史将重新建立，先前删除的收藏不会上传。之后的版本历史（包括已删除内容）可能仍会保留。此验收版本不支持切换账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前收藏及標籤顏色將上傳至你的私人 iCloud 容器並與雲端資料合併。綁定前的本機版本歷史將重新建立，先前刪除的收藏不會上傳。之後的版本歷史（包含已刪除內容）可能仍會保留。此驗收版本不支援切換帳號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のクリップとタグの色をプライベート iCloud コンテナへアップロードし、既存のデータと統合します。連携前のローカル履歴は作り直され、以前削除したクリップはアップロードされません。その後の履歴には削除済みの内容が残る場合があります。この検証版ではアカウント切替はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 클립과 태그 색상을 개인 iCloud 컨테이너에 업로드하고 기존 데이터와 병합합니다. 연결 전 로컬 버전 기록은 다시 생성되며 이전에 삭제한 클립은 업로드되지 않습니다. 이후 기록에는 삭제된 콘텐츠도 남을 수 있습니다. 이 검증 버전에서는 계정을 전환할 수 없습니다."
          }
        }
      }
    },
    "sync.bound.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local data stays available offline. Sync is limited to the linked account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线仍可使用本地收藏，仅与已绑定账户同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線仍可使用本機收藏，僅與已綁定帳號同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインでも利用できます。連携したアカウントのみと同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인에서도 사용할 수 있으며 연결된 계정으로만 동기화됩니다."
