    "sync.history.cloudDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync journal retains versions, including deleted content. Permanent history deletion is not available in this review build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步记录会保留版本，包括删除过的内容。此验收版本暂不支持永久清除历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步記錄會保留版本，包含已刪除內容。此驗收版本暫不支援永久清除歷史。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期履歴には削除済みの内容も含まれます。この検証版では履歴を完全に削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 기록에는 삭제된 콘텐츠도 포함됩니다. 이 검증 버전에서는 기록을 영구 삭제할 수 없습니다."
          }
        }
      }
    },
