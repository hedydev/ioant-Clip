{
  "schemaVersion": 1,
  "title": "Verify extension capture composition and receipts, update signed clients and inspect live Safari state",
  "steps": [
    {
      "name": "regression",
      "runtime": "bash",
      "script": "scripts/cloudkit/validate_localization_update.sh",
      "timeoutSeconds": 300
    },
    {
      "name": "build_mac",
      "runtime": "bash",
      "script": "scripts/cloudkit/build_capture_extensions_mac.sh",
      "timeoutSeconds": 300
    },
    {
      "name": "build_simulator",
      "runtime": "bash",
      "script": "scripts/cloudkit/build_capture_extensions_simulator.sh",
      "timeoutSeconds": 300
    },
    {
      "name": "activate_mac",
      "runtime": "bash",
      "script": "scripts/cloudkit/activate_capture_extensions_mac.sh",
      "timeoutSeconds": 120
    },
    {
      "name": "activate_simulator",
      "runtime": "bash",
      "script": "scripts/cloudkit/activate_capture_extensions_simulator.sh",
      "timeoutSeconds": 120
    },
    {
      "name": "inspect_safari",
      "runtime": "bash",
      "script": "scripts/cloudkit/inspect_capture_runtime.sh",
      "timeoutSeconds": 60
    }
  ],
  "artifacts": []
}
