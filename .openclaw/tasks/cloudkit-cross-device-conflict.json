{
  "schemaVersion": 1,
  "title": "Cross-device edit/delete conflict and resolution smoke",
  "steps": [
    {
      "name": "build_mac",
      "runtime": "bash",
      "script": "scripts/cloudkit/build_signed_smoke_mac.sh",
      "timeoutSeconds": 300
    },
    {
      "name": "build_phone",
      "runtime": "bash",
      "script": "scripts/cloudkit/build_registered_simulator_smoke.sh",
      "timeoutSeconds": 300
    },
    {
      "name": "mac_modify",
      "runtime": "bash",
      "script": "scripts/cloudkit/mac_conflict_modify.sh",
      "timeoutSeconds": 120
    },
    {
      "name": "phone_conflict",
      "runtime": "bash",
      "script": "scripts/cloudkit/phone_conflict.sh",
      "timeoutSeconds": 300
    },
    {
      "name": "mac_resolve",
      "runtime": "bash",
      "script": "scripts/cloudkit/mac_conflict_resolve.sh",
      "timeoutSeconds": 120
    },
    {
      "name": "phone_verify_resolution",
      "runtime": "bash",
      "script": "scripts/cloudkit/phone_verify_resolution.sh",
      "timeoutSeconds": 300
    }
  ],
  "artifacts": []
}
